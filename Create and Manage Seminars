import javax.swing.*;
import java.awt.*;
import java.awt.event.ActionEvent;
import java.awt.event.ActionListener;

// 1. Controller (Matches "SessionController" in diagram)
class SessionCreateController {
    public void createNewSession(String date, String venue, String time, String theme) {
        // Logic: new Session(details)
        Session newSession = new Session(date, venue, time, theme);
        
        // Logic: INSERT Session (Add to mock DB)
        Database.sessions.add(newSession);
    }
}

// 2. GUI (Matches "GUI" in diagram)
public class CreateSeminarUseCase extends JFrame {
    private JTextField txtDate, txtVenue, txtTime, txtTheme;
    private SessionCreateController controller;

    public CreateSeminarUseCase() {
        controller = new SessionCreateController();

        setTitle("Coordinator - Create New Seminar");
        setSize(400, 300);
        setDefaultCloseOperation(JFrame.EXIT_ON_CLOSE);
        setLayout(new GridLayout(5, 2, 10, 10)); // Form layout

        // Form Fields (Matches "Fill form" arrow)
        add(new JLabel("Date (YYYY-MM-DD):"));
        txtDate = new JTextField();
        add(txtDate);

        add(new JLabel("Venue:"));
        txtVenue = new JTextField();
        add(txtVenue);

        add(new JLabel("Time (e.g. 10:00 AM):"));
        txtTime = new JTextField();
        add(txtTime);

        add(new JLabel("Theme / Topic:"));
        txtTheme = new JTextField();
        add(txtTheme);

        JButton btnCreate = new JButton("Create Session");
        add(btnCreate);

        // Event Listener
        btnCreate.addActionListener(new ActionListener() {
            @Override
            public void actionPerformed(ActionEvent e) {
                // Trigger Controller
                controller.createNewSession(
                    txtDate.getText(), 
                    txtVenue.getText(), 
                    txtTime.getText(), 
                    txtTheme.getText()
                );

                // Matches "Confirmation message" arrow
                JOptionPane.showMessageDialog(null, "Session Created Successfully!");
                clearFields();
            }
        });
    }

    private void clearFields() {
        txtDate.setText("");
        txtVenue.setText("");
        txtTime.setText("");
        txtTheme.setText("");
    }

    public static void main(String[] args) {
        SwingUtilities.invokeLater(() -> new CreateSeminarUseCase().setVisible(true));
    }
}
